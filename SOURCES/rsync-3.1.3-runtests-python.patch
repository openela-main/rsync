diff --git a/testsuite/rsyncfns.py b/testsuite/rsyncfns.py
new file mode 100644
index 0000000..c701fc7
--- /dev/null
+++ b/testsuite/rsyncfns.py
@@ -0,0 +1,71 @@
+"""Minimal rsync.fns counterpart for the Python regression tests (3.1.3 backport)."""
+import filecmp, os, re, shlex, shutil, subprocess, sys
+from pathlib import Path
+
+FAIL, ERROR, SKIP, XFAIL = 1, 2, 77, 78
+
+def _required(name):
+    v = os.environ.get(name)
+    if not v:
+        sys.stderr.write("rsyncfns: required env var %s is not set\n" % name)
+        sys.exit(ERROR)
+    return v
+
+SCRATCHDIR = Path(_required('scratchdir'))
+SRCDIR     = Path(_required('srcdir'))
+TOOLDIR    = Path(_required('TOOLDIR'))
+SUITEDIR   = Path(os.environ.get('suitedir', SRCDIR / 'testsuite'))
+RSYNC      = _required('RSYNC')
+TLS_ARGS   = os.environ.get('TLS_ARGS', '')
+os.umask(0o022)
+os.environ['HOME'] = str(SCRATCHDIR)
+
+FROMDIR = SCRATCHDIR / 'from'
+TODIR   = SCRATCHDIR / 'to'
+CHKDIR  = SCRATCHDIR / 'chk'
+
+def split_rsync_cmd(cmd):
+    if os.path.isfile(cmd):
+        return [cmd]
+    for m in reversed(list(re.finditer(r'\s+', cmd))):
+        head = cmd[:m.start()]
+        if os.path.isfile(head):
+            return [head] + shlex.split(cmd[m.start():])
+    return shlex.split(cmd)
+
+def rsync_argv(*args):
+    return split_rsync_cmd(RSYNC) + [str(a) for a in args]
+
+def test_fail(msg):
+    sys.stderr.write(msg.rstrip() + '\n'); sys.exit(FAIL)
+
+def test_skipped(msg):
+    sys.stderr.write(msg.rstrip() + '\n')
+    (SCRATCHDIR / 'whyskipped').write_text(msg.rstrip() + '\n')
+    sys.exit(SKIP)
+
+def run_rsync(*args, check=True, capture_output=False):
+    argv = rsync_argv(*args)
+    if capture_output:
+        # capture_output= and text= are Python 3.7+; spell it the 3.6 way so
+        # this works on RHEL 8's platform-python.
+        proc = subprocess.run(argv, stdout=subprocess.PIPE,
+                              stderr=subprocess.PIPE, universal_newlines=True)
+    else:
+        proc = subprocess.run(argv)
+    if check and proc.returncode != 0:
+        test_fail("rsync exited %d: %s" % (proc.returncode, ' '.join(argv)))
+    return proc
+
+def rmtree(path):
+    p = Path(path)
+    if p.exists() or p.is_symlink():
+        shutil.rmtree(p, ignore_errors=True)
+
+def makepath(*paths):
+    for p in paths:
+        os.makedirs(p, exist_ok=True)
+
+def assert_same(a, b, label=''):
+    if not filecmp.cmp(str(a), str(b), shallow=False):
+        test_fail("%scontent differs between %s and %s" % (label and label + ': ', a, b))
